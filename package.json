{
  "name": "relay-reliability-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "eval": "node --import tsx scripts/run-evals.ts",
    "verify:db": "node --import tsx scripts/verify-db.ts",
    "screenshots": "node --import tsx scripts/capture-screenshots.ts",
    "db:up": "node --import tsx scripts/db-up.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:seed": "node --import tsx scripts/db-seed.ts",
    "db:reset": "node --import tsx scripts/db-reset.ts && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "drizzle-orm": "^0.44.0",
    "next": "^15.5.0",
    "openai": "^5.0.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
